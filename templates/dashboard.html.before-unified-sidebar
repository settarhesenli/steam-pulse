<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Steam Pulse</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: Inter, Arial, Helvetica, sans-serif;
            background: #060b11;
            color: #e8f1f8;
        }

        body {
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* =========================
           LAYOUT
        ========================= */

        .app {
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;

            width: 230px;

            padding: 28px 16px 18px;

            background:
                linear-gradient(
                    180deg,
                    #0b1621 0%,
                    #09121b 100%
                );

            border-right: 1px solid #1c2d3c;

            display: flex;
            flex-direction: column;

            overflow-y: auto;
            overflow-x: hidden;

            z-index: 100;
        }

        .main {
            margin-left: 230px;
            min-height: 100vh;

            padding: 28px 34px 45px;

            background:
                radial-gradient(
                    circle at 80% 10%,
                    rgba(22, 130, 190, .06),
                    transparent 30%
                ),
                #060b11;
        }

        /* =========================
           LOGO
        ========================= */

        .logo {
            display: block;
            margin: 0 10px 38px;

            font-size: 25px;
            line-height: .95;
            font-weight: 900;
            letter-spacing: -.5px;

            color: #f2f7fb;
            text-decoration: none;
            cursor: pointer;
        }

        .logo:hover {
            text-decoration: none;
        }

        .logo span {
            display: block;
            color: #35b6ff;
            margin-top: 4px;
        }

        /* =========================
           NAVIGATION
        ========================= */

        .nav-title {
            text-decoration: none;
            margin: 0 14px 12px;

            color: #50677b;

            font-size: 11px;
            font-weight: 800;

            letter-spacing: 2px;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 5px;

            margin-bottom: 27px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 11px;

            min-height: 45px;

            padding: 0 14px;

            border-radius: 10px;

            color: #8ca0b3;

            font-size: 15px;
            font-weight: 600;

            transition:
                background .18s ease,
                color .18s ease,
                transform .18s ease;
        }

        .nav-link:hover {
            background: #101f2d;
            color: #dcebf5;
        }

        .nav-link.active {
            background: #162d42;
            color: #45baff;
        }

        .nav-icon {
            width: 21px;
            text-align: center;
            font-size: 17px;
        }

        /* =========================
           ACCOUNT
        ========================= */

        .account-panel {
            margin-top: auto;

            padding: 14px;

            border: 1px solid #1b3041;
            border-radius: 14px;

            background: #0a1520;

            flex-shrink: 0;
        }

        .account-top {
            display: flex;
            align-items: center;
            gap: 10px;

            margin-bottom: 12px;
        }

        .avatar {
            width: 36px;
            height: 36px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #082b24;
            border: 1px solid #0ca36c;

            color: #42eaa7;

            font-weight: 800;
        }

        .account-name {
            font-size: 13px;
            font-weight: 800;
            color: #edf5fa;
        }

        .account-status {
            margin-top: 3px;

            color: #587084;

            font-size: 10px;
        }

        .account-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .account-btn {
            padding: 8px 5px;

            text-align: center;

            border-radius: 8px;

            background: #0e1a26;

            color: #8093a6;

            font-size: 11px;
            font-weight: 600;

            border: 1px solid transparent;

            transition: .18s ease;
        }

        .account-btn:hover {
            color: #42baff;
            border-color: #1c415b;
            background: #112536;
        }

        /* =========================
           TOP BAR
        ========================= */

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 34px;
        }

        .search-box {
            width: min(550px, 100%);
        }

        .search-box form {
            margin: 0;
        }

        .search-input {
            width: 100%;

            height: 48px;

            padding: 0 18px;

            border-radius: 10px;

            border: 1px solid #20384c;

            outline: none;

            background: #0d1925;

            color: #eaf4fb;

            font-size: 14px;

            transition: .18s ease;
        }

        .search-input::placeholder {
            color: #62778b;
        }

        .search-input:focus {
            border-color: #299edc;
            box-shadow: 0 0 0 3px rgba(41, 158, 220, .08);
        }

        .live-data {
            display: flex;
            align-items: center;
            gap: 9px;

            color: #45c7ff;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            white-space: nowrap;

            text-shadow: 0 0 8px rgba(69, 199, 255, .35);
        }

        .live-dot {
            width: 8px;
            height: 8px;
            flex-shrink: 0;

            border-radius: 50%;
            background: #58ffad;

            animation: livePulse 2.2s ease-in-out infinite;
        }

        @keyframes livePulse {
            0%, 100% {
                opacity: .30;
                box-shadow:
                    0 0 3px #58ffad,
                    0 0 7px rgba(88, 255, 173, .30);
            }

            50% {
                opacity: 1;
                box-shadow:
                    0 0 7px #58ffad,
                    0 0 18px rgba(88, 255, 173, .90),
                    0 0 30px rgba(88, 255, 173, .35);
            }
        }

@keyframes livePulse {
            0%, 100% {
                opacity: .30;
                box-shadow:
                    0 0 3px #58ffad,
                    0 0 7px rgba(88, 255, 173, .30);
            }

            50% {
                opacity: 1;
                box-shadow:
                    0 0 7px #58ffad,
                    0 0 18px rgba(88, 255, 173, .90),
                    0 0 30px rgba(88, 255, 173, .35);
            }
        }

/* =========================
           HERO
        ========================= */

        .hero {
            position: relative;

            min-height: 300px;

            border-radius: 20px;

            overflow: hidden;

            border: 1px solid #20384c;

            background:
                linear-gradient(
                    90deg,
                    rgba(7, 16, 26, .98) 0%,
                    rgba(7, 16, 26, .93) 35%,
                    rgba(7, 16, 26, .70) 65%,
                    rgba(7, 16, 26, .30) 100%
                ),
                url("https://cdn.akamai.steamstatic.com/steam/apps/730/page_bg_generated_v6b.jpg")
                center / cover no-repeat;
        }

        .hero::after {
            content: "";

            position: absolute;
            inset: 0;

            background:
                linear-gradient(
                    180deg,
                    transparent 55%,
                    rgba(6, 11, 17, .55)
                );

            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 2;

            max-width: 700px;

            padding: 48px 45px;
        }

        .hero-label {
            margin-bottom: 14px;

            color: #42baff;

            font-size: 12px;
            font-weight: 900;

            letter-spacing: 2px;
        }

        .hero h1 {
            margin: 0;

            color: #eef5fa;

            font-size: clamp(38px, 4vw, 58px);
            line-height: 1.03;

            letter-spacing: -1.5px;
        }

        .hero p {
            margin: 22px 0 28px;

            color: #9aabba;

            font-size: 16px;
            line-height: 1.6;
        }

        .hero-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 12px 20px;

            border-radius: 8px;

            background: #159fea;

            color: white;

            font-size: 15px;
            font-weight: 800;

            box-shadow: 0 8px 25px rgba(21, 159, 234, .18);

            transition: .18s ease;
        }

        .hero-button:hover {
            background: #25aaf1;
            transform: translateY(-1px);
        }

        /* =========================
           STATS
        ========================= */

        .stats {
            display: grid;

            grid-template-columns:
                repeat(4, minmax(0, 1fr));

            gap: 15px;

            margin-top: 24px;
        }

        .stat-card {
            min-height: 105px;

            padding: 20px 22px;

            border-radius: 14px;

            border: 1px solid #1b3041;

            background:
                linear-gradient(
                    145deg,
                    #0e1b27,
                    #0b1621
                );
        }

        .stat-label {
            color: #71869a;

            font-size: 11px;
            font-weight: 800;

            letter-spacing: 1px;

            text-transform: uppercase;
        }

        .stat-value {
            margin-top: 10px;

            color: #4db9ff;

            font-size: 32px;
            line-height: 1;

            font-weight: 900;
        }

        .stat-card.sale .stat-value {
            color: #a4ed00;
        }

        .stat-card.free .stat-value {
            color: #eef4f8;
        }

        /* =========================
           DEALS HEADER
        ========================= */

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-top: 34px;
            margin-bottom: 17px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 9px;

            margin: 0;

            color: #edf5fa;

            font-size: 25px;
            font-weight: 900;
        }

        .view-all {
            color: #36b3fa;

            font-size: 12px;
            font-weight: 700;
        }

        .view-all:hover {
            text-decoration: underline;
        }

        /* =========================
           DEALS
        ========================= */

        .deals-grid {
            display: grid;

            grid-template-columns:
                repeat(6, minmax(0, 1fr));

            gap: 14px;
        }

        .deal-card {
            min-width: 0;

            overflow: hidden;

            border-radius: 12px;

            border: 1px solid #1b3041;

            background: #0d1823;

            transition:
                transform .18s ease,
                border-color .18s ease,
                box-shadow .18s ease;
        }

        .deal-card:hover {
            transform: translateY(-4px);

            border-color: #278fca;

            box-shadow:
                0 15px 35px rgba(0, 0, 0, .35);
        }

        .deal-image {
            display: block;

            width: 100%;
            height: 125px;

            object-fit: cover;
        }

        .deal-info {
            padding: 12px;
        }

        .deal-name {
            overflow: hidden;

            color: #edf4f8;

            font-size: 14px;
            font-weight: 800;

            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .deal-developer {
            margin-top: 6px;

            overflow: hidden;

            color: #6f8497;

            font-size: 11px;

            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .deal-bottom {
            display: flex;
            align-items: center;
            gap: 8px;

            margin-top: 13px;
        }

        .deal-price {
            color: #f0f5f8;

            font-size: 14px;
            font-weight: 900;
        }

        .deal-discount {
            padding: 4px 6px;

            border-radius: 5px;

            background: #a8ef00;

            color: #081000;

            font-size: 10px;
            font-weight: 900;
        }

        .no-deals {
            padding: 30px;

            border: 1px solid #1b3041;
            border-radius: 12px;

            color: #71869a;

            background: #0d1823;

            text-align: center;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 1450px) {

            .deals-grid {
                grid-template-columns:
                    repeat(3, minmax(0, 1fr));
            }

        }

        @media (max-width: 1050px) {

            .main {
                padding: 24px;
            }

            .stats {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .deals-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

        }

        @media (max-width: 760px) {

            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 18px;
            }

            .topbar {
                align-items: stretch;
                flex-direction: column;
            }

            .search-box {
                width: 100%;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .deals-grid {
                grid-template-columns: 1fr;
            }

            .hero-content {
                padding: 30px;
            }

            .hero h1 {
                font-size: 38px;
            }

        }

    </style>
</head>

<body>

<div class="app">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <a href="/" class="logo">
            🎮 STEAM
            <span>PULSE</span>
        </a>

        <div class="nav-title">
            DISCOVER
        </div>

        <nav class="nav">

            <a href="/" class="nav-link active">
                <span class="nav-icon">🏠</span>
                <span>Dashboard</span>
            </a>

            <a href="/search" class="nav-link">
                <span class="nav-icon">🔎</span>
                <span>Search Games</span>
            </a>

            <a href="/deals" class="nav-link">
                <span class="nav-icon">🔥</span>
                <span>Deals</span>
            </a>

            {% if session.get('user_id') %}
            <a href="/wishlist" class="nav-link">
                <span class="nav-icon">♡</span>
                <span>Wishlist</span>
            </a>
            {% endif %}

            <a href="/games" class="nav-link">
                <span class="nav-icon">🎮</span>
                <span>All Games</span>
            </a>

        </nav>

        <div class="nav-title">
            INTELLIGENCE
        </div>

        <nav class="nav">

            <a href="/statistics" class="nav-link">
                <span class="nav-icon">📊</span>
                <span>Statistics</span>
            </a>

            <a href="/watchlist" class="nav-link">
                <span class="nav-icon">♥</span>
                <span>Watchlist</span>
            </a>

            <a href="/database" class="nav-link">
                <span class="nav-icon">🗃</span>
                <span>Database</span>
            </a>

        </nav>

        <!-- ACCOUNT -->

        <div class="account-panel">

            {% if session.get('user_id') %}

            <div class="account-top">

                <div class="avatar">
                    S
                </div>

                <div>
                    <div class="account-name">
                        {{ session.get('username', 'settar') }}
                    </div>

                    <div class="account-status">
                        ● Account active
                    </div>
                </div>

            </div>

            <div class="account-actions">

                <a href="/account" class="account-btn">
                    👤 Account
                </a>

                <a href="/logout" class="account-btn">
                    ↪ Logout
                </a>

            </div>

            {% else %}

            <div class="account-top">

                <div class="avatar">
                    G
                </div>

                <div>
                    <div class="account-name">
                        Guest
                    </div>

                    <div class="account-status">
                        ● Not logged in
                    </div>
                </div>

            </div>

            <div class="account-actions">

                <a href="/login" class="account-btn">
                    Login
                </a>

                <a href="/register" class="account-btn">
                    Register
                </a>

            </div>

            {% endif %}

        </div>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">

        <!-- TOP -->

        <div class="topbar">

            <div class="search-box">

                <form action="/search" method="GET">

                    <input
                        class="search-input"
                        type="search"
                        name="q"
                        placeholder="Search Steam games..."
                        autocomplete="off"
                    >

                </form>

            </div>

            <div class="live-data">

                <span class="live-dot"></span>

                LIVE DATA

            </div>

        </div>


        <!-- HERO -->

        <section class="hero">

            <div class="hero-content">

                <div class="hero-label">
                    STEAM MARKET INTELLIGENCE
                </div>

                <h1>
                    Discover Your Next Game
                </h1>

                <p>
                    Track Steam prices, discounts and historical pricing
                    in one place.
                </p>

                <a href="/games" class="hero-button">
                    Explore Games →
                </a>

            </div>

        </section>


        <!-- STATS -->

        <section class="stats">

            <div class="stat-card">

                <div class="stat-label">
                    Total Games
                </div>

                <div class="stat-value">
                    {{ total_games }}
                </div>

            </div>


            <div class="stat-card sale">

                <div class="stat-label">
                    Games On Sale
                </div>

                <div class="stat-value">
                    {{ games_on_sale }}
                </div>

            </div>


            <div class="stat-card free">

                <div class="stat-label">
                    Free Games
                </div>

                <div class="stat-value">
                    {{ free_games }}
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Database
                </div>

                <div class="stat-value">
                    LIVE
                </div>

            </div>

        </section>


        <!-- BIGGEST DEALS -->

        <section>

            <div class="section-header">

                <h2 class="section-title">
                    🔥 Biggest Deals
                </h2>

                <a href="/deals" class="view-all">
                    View all →
                </a>

            </div>


            {% if biggest_discounts %}

            <div class="deals-grid">

                {% for game in biggest_discounts %}

                <a
                    href="/game/{{ game.app_id }}"
                    class="deal-card"
                >

                    {% if game.header_image %}

                    <img
                        class="deal-image"
                        src="{{ game.header_image }}"
                        alt="{{ game.name }}"
                        loading="lazy"
                    >

                    {% else %}

                    <div
                        class="deal-image"
                        style="
                            background:
                            linear-gradient(
                                135deg,
                                #13283a,
                                #081019
                            );
                        "
                    ></div>

                    {% endif %}


                    <div class="deal-info">

                        <div class="deal-name">
                            {{ game.name }}
                        </div>

                        <div class="deal-developer">

                            {{ game.developer or 'Steam' }}

                        </div>

                        <div class="deal-bottom">

                            <span class="deal-price">

                                {% if game.current_price is not none %}

                                    {% if game.current_price == 0 %}
                                        FREE
                                    {% else %}
                                        {{ game.currency or '$' }}
                                        {{ "%.2f"|format(game.current_price / 100) }}
                                    {% endif %}

                                {% else %}

                                    N/A

                                {% endif %}

                            </span>


                            {% if game.discount_percent and game.discount_percent > 0 %}

                            <span class="deal-discount">

                                -{{ game.discount_percent }}%

                            </span>

                            {% endif %}

                        </div>

                    </div>

                </a>

                {% endfor %}

            </div>

            {% else %}

            <div class="no-deals">
                No deals available right now.
            </div>

            {% endif %}

        </section>

    </main>

</div>

</body>
</html>
